diff --git a/hrms-smartoffice-curl-check.sh b/hrms-smartoffice-curl-check.sh
new file mode 100755
index 0000000..903a2fe
--- /dev/null
+++ b/hrms-smartoffice-curl-check.sh
@@ -0,0 +1,337 @@
+#!/usr/bin/env bash
+#
+# hrms-smartoffice-curl-check.sh
+#
+# Hits every SmartOffice endpoint this app talks to (all 21 wrapped in
+# src/lib/smartoffice/client.ts) directly with curl, using the SAME
+# method + path client.ts currently uses. Two of these were already found
+# to be wrong for our deployed instance despite matching
+# SmartOfficeAPIDocumentation.pdf:
+#   - AddEmployee: doc says GET, live server only accepts POST
+#   - GetDeviceCommands: doc says /api/WebAPI/..., live server needs /api/v2/WebAPI/...
+# Given that, this script does NOT trust client.ts's choice blindly: on a
+# clear "route not found" response (HTTP 404, or SmartOffice's own
+# "No HTTP resource was found..." / "does not support http method" body),
+# it automatically retries the OTHER HTTP method against the SAME path and
+# reports which one actually works, so you get a definitive answer per
+# endpoint in one run instead of guessing.
+#
+# ⚠️  SAFETY: several of these endpoints WRITE real data (AddEmployee,
+# AddBiometric, AddCompany, UploadUser, DeleteUser, DeleteEmployee,
+# DeleteBiometric, BlockUserinBiometric, ClearAllLogsFromDevice, ...). This
+# script is meant to run against a SmartOffice TEST/sandbox key, not
+# production. The auto-retry logic above only ever fires when the FIRST
+# attempt returned a routing error (i.e. nothing was mutated), so at most
+# one write happens per endpoint per run — but that one write is real.
+# Identifiers below are prefixed CURLCHECK- for anything that creates or
+# mutates data, specifically so it's easy to spot/clean up afterwards and
+# so it can't collide with a real seeded employee/device. Read-only calls
+# (GetDeviceLogs, GetDeviceCommands, FetchLiveUsers) reuse a real seeded
+# serial number (see prisma/seed.ts) so they return real data if the
+# target instance mirrors this app's seed data.
+#
+# USAGE
+#   cp .env.local .env.local   # make sure SMARTOFFICE_BASE_URL / _API_KEY are set
+#   ./hrms-smartoffice-curl-check.sh
+#
+#   Optional overrides:
+#   SMARTOFFICE_BASE_URL=https://staging.example.com SMARTOFFICE_API_KEY=xxx \
+#     ./hrms-smartoffice-curl-check.sh
+#
+#   Skip the confirmation prompt (e.g. in CI):
+#   NONINTERACTIVE=1 ./hrms-smartoffice-curl-check.sh
+#
+#   Only run read-only endpoints (skip everything that creates/deletes/blocks):
+#   READ_ONLY=1 ./hrms-smartoffice-curl-check.sh
+
+set -uo pipefail
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Config — loaded from .env.local / .env if present, CLI env vars win.
+# ─────────────────────────────────────────────────────────────────────────────
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+for envfile in "$SCRIPT_DIR/.env.local" "$SCRIPT_DIR/.env"; do
+  if [ -f "$envfile" ]; then
+    # shellcheck disable=SC2163
+    set -a
+    # shellcheck disable=SC1090
+    source <(grep -E '^(SMARTOFFICE_BASE_URL|SMARTOFFICE_API_KEY)=' "$envfile")
+    set +a
+  fi
+done
+
+SMARTOFFICE_BASE_URL="${SMARTOFFICE_BASE_URL:-}"
+SMARTOFFICE_API_KEY="${SMARTOFFICE_API_KEY:-}"
+READ_ONLY="${READ_ONLY:-0}"
+NONINTERACTIVE="${NONINTERACTIVE:-0}"
+
+if [ -z "$SMARTOFFICE_BASE_URL" ] || [ "$SMARTOFFICE_BASE_URL" = "http://" ]; then
+  echo "❌ SMARTOFFICE_BASE_URL is not set (checked .env.local, .env, and the environment)."
+  echo "   Set it in .env.local or pass it inline: SMARTOFFICE_BASE_URL=https://... ./hrms-smartoffice-curl-check.sh"
+  exit 1
+fi
+if [ -z "$SMARTOFFICE_API_KEY" ] || [ "$SMARTOFFICE_API_KEY" = "key" ]; then
+  echo "❌ SMARTOFFICE_API_KEY is not set (checked .env.local, .env, and the environment)."
+  exit 1
+fi
+
+BASE_URL="${SMARTOFFICE_BASE_URL%/}"
+
+echo "════════════════════════════════════════════════════════════════"
+echo " SmartOffice endpoint check"
+echo " Base URL : $BASE_URL"
+echo " API key  : ${SMARTOFFICE_API_KEY:0:4}$(printf '%*s' $((${#SMARTOFFICE_API_KEY}-4)) '' | tr ' ' '*')"
+echo " Read-only mode: $([ "$READ_ONLY" = "1" ] && echo "ON — skipping every write/mutate endpoint" || echo "off")"
+echo "════════════════════════════════════════════════════════════════"
+echo
+echo "⚠️  This will send REAL requests to the base URL above, including a"
+echo "   handful that CREATE, DELETE, or BLOCK data (see header comment)."
+echo "   Run this against a SmartOffice TEST/sandbox key, not production."
+if [ "$NONINTERACTIVE" != "1" ]; then
+  read -r -p "Continue? [y/N] " confirm
+  case "$confirm" in
+    y|Y|yes|YES) ;;
+    *) echo "Aborted."; exit 0 ;;
+  esac
+fi
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Sample data — matches prisma/seed.ts where it's a READ (so results are
+# meaningful), uses obviously-fake CURLCHECK- prefixed values for anything
+# that WRITES (so it can't collide with, or accidentally mutate, real data).
+# ─────────────────────────────────────────────────────────────────────────────
+
+TODAY="$(date -u +%Y-%m-%d)"
+YESTERDAY="$(date -u -d 'yesterday' +%Y-%m-%d 2>/dev/null || date -u -v-1d +%Y-%m-%d)"
+
+# Real seeded values (prisma/seed.ts) — used for read-only calls.
+SEED_SERIAL="AMDB24122800519"        # Saket store's device
+SEED_STAFF_CODE="101010001"          # Ramesh Kumar, Saket
+
+# Obviously-fake values — used for anything that creates/mutates/deletes.
+TEST_SERIAL="CURLCHECK-DEVICE-01"
+TEST_DEVICE_NAME="CurlCheck Test Device"
+TEST_STAFF_CODE="CURLCHECK-EMP-01"
+TEST_STAFF_NAME="Curl Check Test Employee"
+TEST_COMPANY_SNAME="CurlChkCo"
+TEST_LOCATION="CurlCheck Location"
+TEST_DESIGNATION="Associate"
+
+# ─────────────────────────────────────────────────────────────────────────────
+# Helpers
+# ─────────────────────────────────────────────────────────────────────────────
+
+PASS=0
+FAIL=0
+UNSURE=0
+
+is_route_not_found() {
+  local body="$1" status="$2"
+  [ "$status" = "404" ] && return 0
+  echo "$body" | grep -qi "No HTTP resource was found" && return 0
+  echo "$body" | grep -qi "does not support http method" && return 0
+  return 1
+}
+
+looks_ok() {
+  local body="$1" status="$2"
+  [ "$status" != "200" ] && return 1
+  echo "$body" | grep -qi '"status"[[:space:]]*:[[:space:]]*"success"' && return 0
+  echo "$body" | grep -qi '"status"[[:space:]]*:[[:space:]]*1' && return 0
+  echo "$body" | grep -qiE 'success|added|deleted|updated|completed' && return 0
+  # SmartOffice sometimes returns a clean typed business-rule error (e.g.
+  # "Employee already exists") on a 200 — that's still a WORKING route,
+  # just not a successful call today. Distinguish it from a 404-shaped body.
+  ! is_route_not_found "$body" "$status" && return 0
+  return 1
+}
+
+# do_get PATH  PAIRS_STR   (PAIRS_STR: "Key1=value one|Key2=value2" — '|'-delimited
+#   so values may safely contain spaces; empty string = no extra params)
+do_get() {
+  local path="$1" pairs_str="${2:-}"
+  local -a curl_args=(-sS -m 20 -G -w '\n__STATUS__:%{http_code}' --data-urlencode "APIKey=${SMARTOFFICE_API_KEY}")
+  if [ -n "$pairs_str" ]; then
+    local -a pairs
+    IFS='|' read -ra pairs <<< "$pairs_str"
+    for pair in "${pairs[@]}"; do
+      curl_args+=(--data-urlencode "$pair")
+    done
+  fi
+  curl "${curl_args[@]}" "${BASE_URL}${path}"
+}
+
+# do_post PATH  JSON_FIELDS   (JSON_FIELDS: `"Key":"value",...` — no braces, no APIKey)
+do_post() {
+  local path="$1" fields="$2"
+  local json
+  json=$(printf '{"APIKey":"%s"%s}' "$SMARTOFFICE_API_KEY" "${fields:+,$fields}")
+  curl -sS -m 20 -X POST -H 'Content-Type: application/json' -w '\n__STATUS__:%{http_code}' -d "$json" "${BASE_URL}${path}"
+}
+
+split_status() {
+  local raw="$1"
+  echo "$raw" | grep -o '__STATUS__:[0-9]*' | cut -d: -f2
+}
+split_body() {
+  local raw="$1"
+  echo "$raw" | sed '$d'
+}
+
+# check NAME  PRIMARY_METHOD  PATH  QUERY_PAIRS_STR  JSON_FIELDS  [WRITE=1]
+#   QUERY_PAIRS_STR: space-separated "Key=value" pairs for the GET attempt
+#   JSON_FIELDS: `"Key":"value",...` for the POST attempt (no braces/APIKey)
+check() {
+  local name="$1" method="$2" path="$3" query_str="$4" json_fields="$5" is_write="${6:-0}"
+
+  if [ "$READ_ONLY" = "1" ] && [ "$is_write" = "1" ]; then
+    echo
+    echo "── ${name} ── SKIPPED (READ_ONLY=1, this endpoint writes data)"
+    return
+  fi
+
+  echo
+  echo "── ${name} ────────────────────────────────────────────────"
+
+  local raw status body
+  if [ "$method" = "GET" ]; then
+    raw=$(do_get "$path" "$query_str")
+  else
+    raw=$(do_post "$path" "$json_fields")
+  fi
+  status=$(split_status "$raw")
+  body=$(split_body "$raw")
+
+  echo "  ${method} ${path}"
+  echo "  → HTTP ${status}   ${body:0:180}"
+
+  if is_route_not_found "$body" "$status"; then
+    local alt
+    [ "$method" = "GET" ] && alt="POST" || alt="GET"
+    echo "  ⚠️  Route/method mismatch — retrying as ${alt}..."
+    if [ "$alt" = "GET" ]; then
+      raw=$(do_get "$path" "$query_str")
+    else
+      raw=$(do_post "$path" "$json_fields")
+    fi
+    status=$(split_status "$raw")
+    body=$(split_body "$raw")
+    echo "  ${alt} ${path}"
+    echo "  → HTTP ${status}   ${body:0:180}"
+
+    if looks_ok "$body" "$status"; then
+      echo "  ✅ Works as ${alt} — client.ts currently uses ${method}. Same class of bug as AddEmployee; fix client.ts to use ${alt}."
+      PASS=$((PASS+1))
+    elif is_route_not_found "$body" "$status"; then
+      echo "  ❌ Neither GET nor POST resolved this path. Check the endpoint name/casing and the 'v2' segment against the live server (browser/Postman), not just the PDF doc."
+      FAIL=$((FAIL+1))
+    else
+      echo "  ❔ Route exists as ${alt} but didn't return a clean success — inspect the body above (may be a business-rule rejection, which is fine/expected for test data)."
+      UNSURE=$((UNSURE+1))
+    fi
+  elif looks_ok "$body" "$status"; then
+    echo "  ✅ ${method} is correct — matches client.ts."
+    PASS=$((PASS+1))
+  else
+    echo "  ❔ Route responded but not with a clean success — inspect the body above (may be a business-rule rejection, e.g. 'already exists', which is fine/expected here)."
+    UNSURE=$((UNSURE+1))
+  fi
+}
+
+# ─────────────────────────────────────────────────────────────────────────────
+# 21 endpoints — same order as src/lib/smartoffice/client.ts
+# ─────────────────────────────────────────────────────────────────────────────
+
+check "1. AddBiometric" POST "/api/v2/WebAPI/AddBiometric" \
+  "" "\"SerialNumber\":\"${TEST_SERIAL}\",\"DeviceName\":\"${TEST_DEVICE_NAME}\"" 1
+
+check "2. DeleteBiometric" GET "/api/v2/WebAPI/DeleteBiometric" \
+  "SerialNumber=${TEST_SERIAL}" "\"SerialNumber\":\"${TEST_SERIAL}\"" 1
+
+check "3. GetDeviceLogs" GET "/api/v2/WebAPI/GetDeviceLogs" \
+  "FromDate=${YESTERDAY}|ToDate=${TODAY}|SerialNumber=${SEED_SERIAL}" \
+  "\"FromDate\":\"${YESTERDAY}\",\"ToDate\":\"${TODAY}\",\"SerialNumber\":\"${SEED_SERIAL}\"" 0
+
+check "4. UploadUser" POST "/api/v2/WebAPI/UploadUser" \
+  "" "\"EmployeeCode\":\"${TEST_STAFF_CODE}\",\"EmployeeName\":\"${TEST_STAFF_NAME}\",\"SerialNumber\":\"${TEST_SERIAL}\"" 1
+
+check "5. DeleteUser" POST "/api/v2/WebAPI/DeleteUser" \
+  "" "\"EmployeeCode\":\"${TEST_STAFF_CODE}\",\"SerialNumber\":\"${TEST_SERIAL}\"" 1
+
+check "6. FetchLiveUsersFromBiometric" GET "/api/v2/WebAPI/FetchLiveUsersFromBiometric" \
+  "SerialNumber=${SEED_SERIAL}" "\"SerialNumber\":\"${SEED_SERIAL}\"" 0
+
+check "7. SetUserExpiration" GET "/api/v2/WebAPI/SetUserExpiration" \
+  "SerialNumber=${TEST_SERIAL}|EmployeeCode=${TEST_STAFF_CODE}|ExpirationDate=2030-12-31" \
+  "\"SerialNumber\":\"${TEST_SERIAL}\",\"EmployeeCode\":\"${TEST_STAFF_CODE}\",\"ExpirationDate\":\"2030-12-31\"" 1
+
+check "8. GetDeviceCommands (confirmed working as v2/GET already)" GET "/api/v2/WebAPI/GetDeviceCommands" \
+  "FromDate=${YESTERDAY}|ToDate=${TODAY}" \
+  "\"FromDate\":\"${YESTERDAY}\",\"ToDate\":\"${TODAY}\"" 0
+
+echo
+echo "── 9. PhotoUploadInBiometric ────────────────────────────────────"
+echo "  ⏭  SKIPPED — not wired up in client.ts (throws intentionally, see Section 7.1 of the spec)."
+
+check "10. BlockUserinBiometric (client.ts deliberately omits v2 here — worth re-checking)" GET "/api/WebAPI/BlockUserinBiometric" \
+  "EmployeeCode=${TEST_STAFF_CODE}|SerialNumber=${TEST_SERIAL}|BlockUser=0" \
+  "\"EmployeeCode\":\"${TEST_STAFF_CODE}\",\"SerialNumber\":\"${TEST_SERIAL}\",\"BlockUser\":0" 1
+echo "  ℹ️  If this failed, also try the v2 path by hand:"
+echo "     curl -G --data-urlencode \"APIKey=\$SMARTOFFICE_API_KEY\" --data-urlencode \"EmployeeCode=${TEST_STAFF_CODE}\" --data-urlencode \"SerialNumber=${TEST_SERIAL}\" --data-urlencode \"BlockUser=0\" \"${BASE_URL}/api/v2/WebAPI/BlockUserinBiometric\""
+
+check "11. ClearAllLogsFromDevice" GET "/api/v2/WebAPI/ClearAllLogsFromDevice" \
+  "SerialNumber=${TEST_SERIAL}" "\"SerialNumber\":\"${TEST_SERIAL}\"" 1
+
+check "12. ClearLogsFromDeviceByTime (Speed Face models only)" GET "/api/v2/WebAPI/ClearLogsFromDeviceByTime" \
+  "SerialNumber=${TEST_SERIAL}|StartTime=${YESTERDAY} 09:00|EndTime=${TODAY} 09:00" \
+  "\"SerialNumber\":\"${TEST_SERIAL}\",\"StartTime\":\"${YESTERDAY} 09:00\",\"EndTime\":\"${TODAY} 09:00\"" 1
+
+check "13. TriggerUserOnlineEnrollment" GET "/api/v2/WebAPI/TriggerUserOnlineEnrollment" \
+  "SerialNumber=${TEST_SERIAL}|EmployeeCode=${TEST_STAFF_CODE}|EmployeeName=${TEST_STAFF_NAME}" \
+  "\"SerialNumber\":\"${TEST_SERIAL}\",\"EmployeeCode\":\"${TEST_STAFF_CODE}\",\"EmployeeName\":\"${TEST_STAFF_NAME}\"" 1
+
+check "14. AddEmployee (confirmed working as v2/POST already)" POST "/api/v2/WebAPI/AddEmployee" \
+  "" "\"StaffCode\":\"${TEST_STAFF_CODE}\",\"StaffName\":\"${TEST_STAFF_NAME}\",\"CompanySName\":\"${TEST_COMPANY_SNAME}\",\"Location\":\"${TEST_LOCATION}\",\"Designation\":\"${TEST_DESIGNATION}\"" 1
+
+check "15. DeleteEmployee" GET "/api/v2/WebAPI/DeleteEmployee" \
+  "EmployeeCode=${TEST_STAFF_CODE}" "\"EmployeeCode\":\"${TEST_STAFF_CODE}\"" 1
+
+check "16. AddCompany" GET "/api/v2/WebAPI/AddCompany" \
+  "BranchFullName=CurlCheck Company|BranchShortName=${TEST_COMPANY_SNAME}" \
+  "\"BranchFullName\":\"CurlCheck Company\",\"BranchShortName\":\"${TEST_COMPANY_SNAME}\"" 1
+
+check "17. AddDepartment" GET "/api/v2/WebAPI/AddDepartment" \
+  "DepartmentFName=CurlCheck Department|DepartmentSName=CCDept" \
+  "\"DepartmentFName\":\"CurlCheck Department\",\"DepartmentSName\":\"CCDept\"" 1
+
+check "18. AddLocation" GET "/api/v2/WebAPI/AddLocation" \
+  "LocationName=${TEST_LOCATION}|LocationCode=CCLOC01" \
+  "\"LocationName\":\"${TEST_LOCATION}\",\"LocationCode\":\"CCLOC01\"" 1
+
+check "19. AddDesignation" GET "/api/v2/WebAPI/AddDesignation" \
+  "DesignationsName=${TEST_DESIGNATION}|DesignationCode=CCDESG01" \
+  "\"DesignationsName\":\"${TEST_DESIGNATION}\",\"DesignationCode\":\"CCDESG01\"" 1
+
+check "20. AddGrade" GET "/api/v2/WebAPI/AddGrade" \
+  "GradeCode=CCGR01|GradeName=CurlCheck Grade" \
+  "\"GradeCode\":\"CCGR01\",\"GradeName\":\"CurlCheck Grade\"" 1
+
+check "21. AddTeam" GET "/api/v2/WebAPI/AddTeam" \
+  "TeamCode=CCTM01|TeamName=CurlCheck Team" \
+  "\"TeamCode\":\"CCTM01\",\"TeamName\":\"CurlCheck Team\"" 1
+
+# ─────────────────────────────────────────────────────────────────────────────
+
+echo
+echo "════════════════════════════════════════════════════════════════"
+echo " Done.  ✅ ${PASS}   ❔ ${UNSURE}   ❌ ${FAIL}"
+echo " ✅  = route confirmed working (may still be a business-rule reject, see body)"
+echo " ❔  = route responded but the body didn't parse as a clean success — read it"
+echo " ❌  = route not found on either GET or POST — check the path/segment by hand"
+echo "════════════════════════════════════════════════════════════════"
+echo
+echo "For anything marked ✅ under the 'retrying as X' branch, or ❌, update the"
+echo "matching function in src/lib/smartoffice/client.ts (method and/or path) and"
+echo "note the correction in a comment the same way AddEmployee's already is —"
+echo "future-you (and the worker) needs to know this deviates from the PDF doc."
