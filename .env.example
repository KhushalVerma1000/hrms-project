# Database (Prisma Postgres managed connection)
DATABASE_URL="prisma+postgres://"
# Direct (non-pooled) connection for pg-boss worker — required!
DATABASE_DIRECT_URL="postgres://"

# Auth.js
AUTH_SECRET="random-secret"
NEXTAUTH_URL="http://localhost:3000"

# SmartOffice API
SMARTOFFICE_BASE_URL="http://"
SMARTOFFICE_API_KEY="key"

# SmartOffice timestamp timezone
# IST confirmed. Change to 'UTC' or another IANA zone string if your SmartOffice
# deployment differs. Affects all first-in/last-out day-boundary calculations.
SMARTOFFICE_TIMEZONE="Asia/Kolkata"

# Cron job protection secret — sent in X-Cron-Secret header by Vercel Cron
CRON_SECRET="your-cron-secret"

# Google Forms onboarding tracking (Section 13)
# Apps Script webhook shared secret — sent in X-Webhook-Secret header on each submission
FORM_WEBHOOK_SECRET="your-webhook-secret"
# Base URL of the Google Form (without query params)
GOOGLE_FORM_BASE_URL="https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform"
# The ?entry.<id> field ID for the Employee Code field on the form
GOOGLE_FORM_ECODE_FIELD_ID="entry.1234567890"
# Only needed if using the Sheets-polling fallback instead of the Apps Script webhook:
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={...}
# GOOGLE_SHEETS_SHEET_ID="your-sheet-id"

# Node environment
NODE_ENV="development"
