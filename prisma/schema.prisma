generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Application roles — controls what a logged-in User can do.
 * Associate and Quality Associate are intentionally NOT roles; they have
 * no app access and never get a User record. See Section 2.1 of the spec.
 */
enum Role {
  ADMIN
  CLIENT
  MANAGER
  PROCESS_ASSOCIATE
  SHIFT_INCHARGE
}

/**
 * Staff designations — applies to Employee records only (biometric enrollment,
 * attendance tracking). Only PROCESS_ASSOCIATE and SHIFT_INCHARGE designations
 * additionally get a linked User record for app access.
 * MANAGER is NOT a designation — Managers are created via User & Role
 * Management and have no Employee record (no biometric enrollment).
 */
enum Designation {
  ASSOCIATE          /// No app access. Employee record only.
  PROCESS_ASSOCIATE  /// Has app access. Linked User record created at onboarding.
  QUALITY_ASSOCIATE  /// No app access. Employee record only.
  SHIFT_INCHARGE     /// Has app access. Linked User record created at onboarding.
  HOUSEKEEPING       /// No app access. Employee record only — attendance-tracked like Associate/QA.
  OTHER              /// Catchall for non-standard designations.
}

/**
 * Whether a Store's attendance is captured via a physical biometric device
 * (synced from SmartOffice) or entered manually through this app's web UI
 * by the store's Manager/Shift Incharge. Chosen at store creation, editable
 * afterward by Admin/Client if the store's hardware situation changes.
 */
enum AttendanceMode {
  BIOMETRIC  /// Default. Attendance comes from SmartOffice GetDeviceLogs sync (Section 7.2).
  MANUAL     /// No biometric device at this store. Manager/SI record attendance directly.
}

/**
 * Daily attendance status for a MANUAL-mode store's manual entry form,
 * and for the same-shaped rows in a CSV upload (Section: CSV Upload spec).
 * Kept deliberately short — WEEK_OFF/HOLIDAY added alongside CSV upload so a
 * whole month's roster can be marked without every non-working day landing
 * in ON_LEAVE, which would otherwise pollute leave-balance reporting.
 */
enum ManualAttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  WEEK_OFF
  HOLIDAY
}

/**
 * Where a ManualAttendanceEntry row came from — the Daily Register (one row,
 * one save) or a committed CSV upload batch (many rows, one save). Both write
 * through the same upsert path; this field is purely for audit/reporting.
 */
enum AttendanceEntrySource {
  MANUAL_DAILY_EDIT
  MANUAL_CSV
}

/**
 * Deadline policy scope — CLIENT rows are the default for every store under
 * that client; a STORE row overrides the client default for one specific store.
 * Resolution order: store override > client default > SYSTEM_DEFAULT_DEADLINE_DAY.
 */
enum DeadlineScope {
  CLIENT
  STORE
}

/**
 * Lifecycle of one store's one calendar month attendance window.
 * See AttendancePeriod below for the full state machine in context.
 */
enum PeriodStatus {
  OPEN           /// Before deadline, uploads/edits allowed.
  CLOSED         /// Submitted on time, finalized.
  MISSED         /// Deadline passed, nothing submitted — uploads blocked, must request late access.
  LATE_REQUESTED /// Manager filed a late-access request, awaiting Admin decision.
  LATE_GRANTED   /// Admin approved — uploads allowed again until grantedUntil.
  LATE_DENIED    /// Admin denied — manager may file a new request.
  CLOSED_LATE    /// Uploaded successfully under an approved late grant.
}

enum LateRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum BatchStatus {
  VALIDATING
  VALIDATED_PENDING_COMMIT
  COMMITTED
  FAILED
}

/**
 * Where EmployeeMonthlyOvertime.totalHours came from — a straight sum of
 * daily otHours entries, or one manually-entered monthly figure when the
 * manager used the "monthly total" CSV template mode instead of "daily OT".
 */
enum OvertimeSource {
  DAILY_SUM
  MANUAL_TOTAL
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

enum CommandStatus {
  PENDING      /// Waiting to be dispatched to SmartOffice.
  IN_PROGRESS  /// Worker has claimed this job and is calling SmartOffice.
  SUCCEEDED    /// SmartOffice acknowledged success.
  FAILED       /// Terminal — exhausted retries OR got a business-rule rejection.
}

enum OnboardingFormStatus {
  NOT_SENT   /// Employee onboarded in-app; form link not yet shared with them.
  PENDING    /// Form link shared; not yet submitted.
  SUBMITTED  /// Confirmed submitted and matched via webhook/polling.
}

/// Which biometric backend a Device is wired to. SmartOffice is the only
/// vendor integration today (Patch A/B); MANUAL formalizes stores that have
/// no biometric device at all. Add new values only once an adapter for that
/// vendor actually exists (Patch D+) — see src/lib/biometric/.
enum BiometricProviderType {
  SMARTOFFICE
  MANUAL
  // Future: ESSL, ZKTECO, GENERIC_REST — add as adapters are built.
}

// ─────────────────────────────────────────────────────────────────────────────
// CORE MODELS
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Atomic counter table for code assignment.
 * Rows: "client", "warehouseType", "storeCode:{clientId}"
 * Used by the e-code generation engine (Section 11).
 */
model Counter {
  id    String @id
  value Int    @default(0)
}

/**
 * A vendor/staffing account you manage.
 * Internal to this app — SmartOffice has no concept of this entity.
 */
model Client {
  id        String   @id @default(cuid())
  /// 2-digit globally-unique code, auto-assigned on creation (never user-entered).
  /// Starts at "10" — never "01"-style — so the assembled e-code never begins
  /// with a leading zero (which gets silently stripped if the code is ever
  /// opened in Excel/Sheets or treated as a number anywhere downstream).
  code      String   @unique @db.Char(2)
  /// e.g. "Mansa Maharani"
  name      String
  shortName String
  email     String?
  /// City/region, e.g. "New Delhi, India". Free text, display-only.
  location  String?
  /// 15-character GST Identification Number for this vendor account, if registered.
  gstin     String?

  /// Per-client Google Form onboarding link override (Section 13.1/13.5).
  /// If null, the app falls back to the global GOOGLE_FORM_BASE_URL/FIELD_ID env vars.
  googleFormBaseUrl      String?
  googleFormECodeFieldId String?

  stores    Store[]
  users     User[]
  deadlinePolicies AttendanceDeadlinePolicy[]
  createdAt DateTime @default(now())
}

/**
 * A brand / big company whose warehouse the client operates.
 * e.g. "Amazon", "Blinkit", "Zepto".
 * Global shared list — Admin-managed only. Maps to SmartOffice Branch/CompanySName.
 */
model WarehouseType {
  id        String   @id @default(cuid())
  /// 2-digit globally-unique code, auto-assigned on creation. Starts at "10" —
  /// see Client.code comment for why (not strictly required for THIS segment
  /// since it's never first in the e-code, but kept consistent across all
  /// three code types rather than special-casing just the Client segment).
  code      String   @unique @db.Char(2)
  /// e.g. "Amazon" — unique across all brands.
  name      String   @unique
  stores    Store[]
  createdAt DateTime @default(now())
}

/**
 * A physical warehouse site. Belongs to one Client, operates under one WarehouseType.
 * Maps to SmartOffice Location.
 */
model Store {
  id                String   @id @default(cuid())
  /// 2-digit code, unique within its Client (not globally). Auto-assigned, starts at "10".
  code              String   @db.Char(2)
  /// Optional external brand reference code (e.g. Amazon's "TD02"). Display-only.
  externalStoreCode String?
  name              String

  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  warehouseTypeId String
  warehouseType   WarehouseType @relation(fields: [warehouseTypeId], references: [id])

  /// Atomic counter for per-store employee serial in e-code generation.
  /// Starts at 100 (not 1) so the 3-digit Serial segment never has a
  /// leading zero either — see Client.code comment for why that matters.
  nextEmployeeSerial Int @default(100)

  /// BIOMETRIC (default, synced from SmartOffice) or MANUAL (no device —
  /// Manager/SI enter attendance via ManualAttendanceEntry below). Editable
  /// after creation by Admin/Client if the store's hardware situation changes.
  attendanceMode AttendanceMode @default(MANUAL)

  address        String?
  /// City/area, e.g. "Saket, New Delhi". Shorter than `address` — for
  /// quick display/filtering, not geofencing (see latitude/longitude below).
  location       String?
  latitude       Float?
  longitude      Float?
  /// Geofence radius in meters — mirrors SmartOffice AddLocation.Radius.
  geofenceRadius Int?
  /// 15-character GST Identification Number for this store's registered
  /// address, if it differs from the parent Client's GSTIN.
  gstin          String?

  devices   Device[]
  employees Employee[]
  users     User[]
  deadlinePolicyOverride AttendanceDeadlinePolicy[]
  attendancePeriods      AttendancePeriod[]

  createdAt DateTime @default(now())

  /// Store codes are unique within a client, not globally.
  @@unique([clientId, code])
}

/**
 * A biometric device (fingerprint/face scanner) at a store.
 */
model Device {
  id           String    @id @default(cuid())
  serialNumber String    @unique
  name         String
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id])
  /// Used to feature-flag clearLogsFromDeviceByTime (Speed Face models only).
  model        String?
  isOnline     Boolean   @default(false)
  lastPing     DateTime?
  userCount    Int?
  /// Defaults to 0 (not null) — Prisma's `{ increment }` on a NULL column
  /// silently stays NULL in Postgres, so this must start at 0 to ever count.
  attLogsCount Int       @default(0)
  createdAt    DateTime  @default(now())

  /// Which biometric backend this device talks to. Every existing Device is
  /// backfilled to the default SmartOffice config on migration — zero
  /// behavior change on day one (see BiometricProviderConfig).
  providerId String
  provider   BiometricProviderConfig @relation(fields: [providerId], references: [id])

  @@index([providerId])
}

/**
 * Config row for a biometric backend a Device can be wired to (Section 2/3 of
 * the biometric-provider-modularization spec). Provider selection is a
 * per-device *data* decision (this table), not a code decision — onboarding a
 * new vendor means implementing its adapter once and inserting a row here,
 * with zero changes to onboarding/attendance/device route logic.
 */
model BiometricProviderConfig {
  id   String                @id @default(cuid())
  type BiometricProviderType

  /// e.g. "SmartOffice — Primary", shown in device admin UI.
  label String

  baseUrl String?

  /// Name of the env var holding the API key — NOT the key itself. Storing a
  /// pointer instead of the secret avoids taking on secret-encryption-at-rest
  /// scope while single-tenant on SmartOffice; revisit with a KMS-backed
  /// secrets table once a second client brings their own vendor credentials.
  apiKeyEnv String?

  timezone String?

  /// Used to pre-select a provider when creating a new Device.
  isDefault Boolean @default(false)

  devices Device[]

  createdAt DateTime @default(now())
}

/**
 * A warehouse associate/staff member tracked for biometric attendance.
 * IMPORTANT: Managers are NOT employees in this system (no biometric enrollment,
 * no attendance record). See Section 10 of the spec.
 */
model Employee {
  id          String         @id @default(cuid())
  /// System-generated e-code for new hires (Section 11, v2): [Client:2][Brand:2][Store:2][Serial:3][Check:1],
  /// 10 digits total, e.g. "1010100109" — the last digit is a Luhn check digit
  /// over the first 9, so a mistyped/transposed digit is self-detectable
  /// without a DB lookup (see src/lib/ecode.ts: isValidChecksum/verifyEmployeeCode).
  /// Codes never start with 0 (Client.code starts at "10").
  /// Legacy records use their original SmartOffice staffCode (9 digits, no
  /// check digit), flagged with isLegacyCode = true.
  staffCode   String         @unique
  isLegacyCode Boolean       @default(false)
  name        String
  gender      String?
  status      EmployeeStatus @default(ACTIVE)

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  /// Drives whether this person gets a linked User login (PA/SI only).
  designation Designation @default(ASSOCIATE)
  grade       String?
  team        String?

  dateOfJoining      DateTime?
  dateOfConfirmation DateTime?
  dateOfBirth        DateTime?
  dateOfRelieving    DateTime?
  cardNumber         String?

  /// Tracks progress through the multi-step onboarding wizard (resumable).
  onboardingStep String?

  /// Google Forms onboarding paperwork tracking (Section 13).
  onboardingFormStatus         OnboardingFormStatus @default(NOT_SENT)
  onboardingFormSentAt         DateTime?
  onboardingFormSubmittedAt    DateTime?
  onboardingFormLastRemindedAt DateTime?

  /// Present only if designation = PROCESS_ASSOCIATE or SHIFT_INCHARGE and a login was created.
  linkedUser User?

  /// Manual attendance entries recorded on this employee's behalf — only
  /// populated if this employee's Store has attendanceMode = MANUAL.
  manualAttendanceEntries ManualAttendanceEntry[]
  monthlyOvertimes        EmployeeMonthlyOvertime[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * An app user (person with login credentials and role-based access).
 * NOT to be confused with Employee — Managers, Admin, Client users may never
 * have a corresponding Employee record.
 */
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  role         Role

  /// Set only if role = CLIENT. Scopes this user to a specific client.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  /// Set if role = MANAGER / PROCESS_ASSOCIATE / SHIFT_INCHARGE.
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  /// Set ONLY for PROCESS_ASSOCIATE / SHIFT_INCHARGE — links their app login
  /// to their own attendance-tracked Employee record. NULL for ADMIN/CLIENT/MANAGER.
  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  /// Whether user must change password on next login (new accounts).
  mustChangePassword Boolean  @default(false)

  createdAt DateTime   @default(now())
  auditLogs AuditLog[]
  /// Manual attendance entries this user has personally recorded (Manager/SI, MANUAL-mode stores only).
  manualAttendanceEntriesEntered ManualAttendanceEntry[]
  lateUploadRequestsFiled    LateUploadRequest[] @relation("LateRequestsFiled")
  lateUploadRequestsResolved LateUploadRequest[] @relation("LateRequestsResolved")
  attendanceUploadBatches    AttendanceUploadBatch[]
}

/**
 * Raw attendance punch data, synced from SmartOffice GetDeviceLogs.
 * This is a local cache — SmartOffice is the source of truth for raw punches.
 */
model AttendanceLog {
  id             String    @id @default(cuid())
  employeeCode   String
  logDate        DateTime
  serialNumber   String
  punchDirection String?
  temperature    Float?
  syncedAt       DateTime  @default(now())

  @@unique([employeeCode, logDate, serialNumber])
  @@index([employeeCode, logDate])
  @@index([serialNumber, logDate])
}

/**
 * Immutable audit log for all destructive and write actions.
 * Written for every enqueued command and every destructive server action,
 * regardless of SmartOffice response.
 */
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  /// e.g. "EMPLOYEE_HARD_DELETE", "DEVICE_UPLOAD_USER", "COMMAND_ENQUEUED"
  action     String
  /// "Employee" | "Device" | "Store" | "Client" | "User" | "Command"
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([targetType, targetId])
}

/**
 * Durable outbound command queue for all SmartOffice write operations.
 * Every write to SmartOffice goes through this table — local DB is written first,
 * then a command row is inserted, and the worker dispatches it asynchronously.
 * See Section 12 of the spec.
 */
model SmartOfficeCommand {
  id  String @id @default(cuid())

  /// Deterministically derived from the action — prevents duplicate enqueue and
  /// duplicate dispatch after worker crash. See Section 12.2.1 of the spec.
  idempotencyKey String @unique

  /// e.g. "ADD_EMPLOYEE", "UPLOAD_USER", "DELETE_USER", "ADD_LOCATION", "BLOCK_USER"
  commandType String

  /// Exact request parameters to be sent to the SmartOffice endpoint.
  payload Json

  status      CommandStatus @default(PENDING)
  attempts    Int           @default(0)
  /// Default 6 attempts with exponential backoff: 1m→5m→15m→1h→4h→12h.
  maxAttempts Int           @default(6)

  lastError     String?
  lastAttemptAt DateTime?
  /// Worker queries: WHERE status = PENDING AND nextAttemptAt <= now()
  nextAttemptAt DateTime @default(now())

  /// "Employee" | "Store" | "Device" | "Client"
  relatedType String?
  relatedId   String?

  /// userId of the person who triggered this command.
  createdBy  String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, nextAttemptAt])
}

/**
 * Manual attendance entry for stores with attendanceMode = MANUAL (no biometric
 * device). Recorded by Manager/Shift Incharge through a web form rather than
 * synced from SmartOffice. One row per employee per calendar day — re-saving
 * the same day overwrites the previous entry (upsert on [employeeId, date]).
 *
 * This is deliberately a SEPARATE model from AttendanceLog rather than
 * shoehorning manual entries into the raw-punch-log schema: AttendanceLog
 * models individual IN/OUT device events, which is the wrong shape for a
 * "was this person present today" daily record. Keeping them separate avoids
 * awkward nullable-serialNumber/unique-constraint hacks on AttendanceLog.
 */
model ManualAttendanceEntry {
  id     String   @id @default(cuid())
  date   DateTime @db.Date /// Calendar day only, no time component.
  status ManualAttendanceStatus

  /// Optional — Manager/SI can record actual clock times if they want to,
  /// or just mark PRESENT/ABSENT/HALF_DAY/ON_LEAVE without times.
  checkInTime  DateTime?
  checkOutTime DateTime?
  notes        String?

  /// PER-DAY overtime hours. Only populated when the entry came from the
  /// Daily Register with OT entered directly, or a CSV batch uploaded in
  /// "daily OT" mode. Left null for "monthly total" mode uploads — see
  /// EmployeeMonthlyOvertime, which is the value payroll actually reads.
  otHours Decimal? @db.Decimal(5, 2)

  /// MANUAL_DAILY_EDIT (Daily Register, one row) or MANUAL_CSV (CSV batch,
  /// many rows) — both write through this same model/upsert path.
  source AttendanceEntrySource @default(MANUAL_DAILY_EDIT)

  /// Set when source = MANUAL_CSV — links back to the batch that wrote this row.
  uploadBatchId String?
  uploadBatch   AttendanceUploadBatch? @relation(fields: [uploadBatchId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  /// Who recorded/last-edited this entry — always Manager or Shift Incharge
  /// (or Admin/Client), enforced by can('attendance:manualEntry') at the
  /// action layer plus a runtime check that the Store is actually MANUAL mode.
  enteredByUserId String
  enteredByUser   User   @relation(fields: [enteredByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([uploadBatchId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE CSV UPLOAD, MONTHLY DEADLINES & OVERTIME
// See attendance-upload-and-daily-register-spec.md for the full design.
// ─────────────────────────────────────────────────────────────────────────────

/**
 * Deadline policy: how many days into the following month a store's
 * attendance for a given month is due. One CLIENT row = default for every
 * store under that client. One STORE row = override for a single store.
 * Resolution done in code (src/lib/attendance/period.ts), not in SQL.
 */
model AttendanceDeadlinePolicy {
  id          String        @id @default(cuid())
  scope       DeadlineScope
  /// One row per Client (scope = CLIENT). Field-level @unique so multiple
  /// clients can each have a row while storeId stays NULL on all of them —
  /// Postgres treats NULLs as distinct in a unique index, which is exactly
  /// what's needed here.
  clientId    String?       @unique
  client      Client?       @relation(fields: [clientId], references: [id])
  /// One row per Store (scope = STORE), overriding that store's client default.
  storeId     String?       @unique
  store       Store?        @relation(fields: [storeId], references: [id])
  /// Day-of-month in the month AFTER the one being reported, e.g. 5 = "5th
  /// of the following month". Attendance for August is due before 5 Sep.
  deadlineDay Int
  createdByUserId String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/**
 * One store's one calendar-month attendance window. Created lazily (first
 * access, or a daily cron opening next month's window on the 1st).
 * deadlineAt is snapshotted from AttendanceDeadlinePolicy at creation time —
 * editing the policy later does NOT retroactively move an already-open
 * period's deadline. Extending an individual period is what the late-access
 * grant (LateUploadRequest.grantedUntil) is for.
 */
model AttendancePeriod {
  id          String       @id @default(cuid())
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id])
  periodYear  Int
  periodMonth Int          /// 1–12, the month attendance covers (August = 8)
  deadlineAt  DateTime
  status      PeriodStatus @default(OPEN)
  submittedAt DateTime?
  closedAt    DateTime?
  isLate      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  uploadBatches     AttendanceUploadBatch[]
  lateRequests      LateUploadRequest[]
  monthlyOvertimes  EmployeeMonthlyOvertime[]

  @@unique([storeId, periodYear, periodMonth])
  @@index([status])
}

/**
 * A manager's request to unlock uploads for a MISSED period, and the
 * Admin's decision. grantedUntil is an explicit date/time chosen by the
 * Admin at approval time — not a fixed "+N days" rule.
 */
model LateUploadRequest {
  id             String             @id @default(cuid())
  periodId       String
  period         AttendancePeriod   @relation(fields: [periodId], references: [id])
  requestedByUserId String
  requestedByUser   User            @relation("LateRequestsFiled", fields: [requestedByUserId], references: [id])
  requestedAt    DateTime           @default(now())
  reason         String?
  status         LateRequestStatus  @default(PENDING)
  resolvedByUserId String?
  resolvedByUser   User?            @relation("LateRequestsResolved", fields: [resolvedByUserId], references: [id])
  resolvedAt     DateTime?
  grantedUntil   DateTime?
  adminNote      String?

  @@index([periodId, status])
}

/**
 * One CSV upload attempt for one store+period. Validation runs first
 * (VALIDATING → VALIDATED_PENDING_COMMIT, nothing written to
 * ManualAttendanceEntry yet); the manager reviews flagged rows, then a
 * separate commit step writes the actual attendance rows and flips this
 * to COMMITTED. parsedSnapshot/errorReport hold the full row-level detail
 * for audit — there's no object storage in this app yet, so the raw file
 * itself isn't retained, only the parsed+validated data.
 */
model AttendanceUploadBatch {
  id             String      @id @default(cuid())
  periodId       String
  period         AttendancePeriod @relation(fields: [periodId], references: [id])
  storeId        String
  uploadedByUserId String
  uploadedByUser   User      @relation(fields: [uploadedByUserId], references: [id])
  uploadedAt     DateTime    @default(now())
  fileName       String
  /// Detected from the CSV header shape — paired "N_OT" columns vs one
  /// trailing "OT_Hours" column. See src/lib/attendance/csv.ts.
  otMode         OvertimeSource
  status         BatchStatus @default(VALIDATING)
  rowCount       Int         @default(0)
  errorCount     Int         @default(0)
  warningCount   Int         @default(0)
  isLate         Boolean     @default(false)
  parsedSnapshot Json?
  errorReport    Json?

  /// The actual ManualAttendanceEntry rows this batch wrote (only once COMMITTED).
  manualAttendanceEntries ManualAttendanceEntry[]

  @@index([periodId, status])
}

/**
 * The monthly OT figure payroll actually reads, regardless of which CSV
 * template mode produced it. DAILY_SUM = sum of ManualAttendanceEntry.otHours
 * across the period; MANUAL_TOTAL = one figure entered directly (no daily
 * breakdown). hasDiscrepancy is set when a Mode A ("daily OT") upload's
 * figure disagrees with SmartOffice-derived OT for a Biometric store.
 * NOTE: SmartOffice/AttendanceLog has no OT field today — "SmartOffice OT"
 * here means an approximation computed from raw punch times (see
 * src/lib/attendance/biometricOt.ts). Flagged as an assumption to confirm.
 */
model EmployeeMonthlyOvertime {
  id             String         @id @default(cuid())
  periodId       String
  period         AttendancePeriod @relation(fields: [periodId], references: [id])
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id])
  totalHours     Decimal        @db.Decimal(6, 2)
  source         OvertimeSource
  hasDiscrepancy Boolean        @default(false)
  updatedAt      DateTime       @updatedAt

  @@unique([periodId, employeeId])
}

/**
 * Google Form submissions that could not be matched to an Employee by staffCode.
 * Admin can manually reconcile these.
 */
model UnmatchedFormSubmission {
  id              String   @id @default(cuid())
  rawPayload      Json
  submittedAt     DateTime
  staffCodeGuess  String?  /// The staffCode extracted from the submission (if any)
  resolvedAt      DateTime?
  resolvedByUserId String?
  createdAt       DateTime @default(now())
}
